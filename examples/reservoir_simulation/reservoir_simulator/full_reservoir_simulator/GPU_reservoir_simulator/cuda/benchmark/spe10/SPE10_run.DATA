-- =====================================================================
--  SPE10 — Tenth SPE Comparative Solution Project, model 2
--  Christie & Blunt, SPE 72469 (2001).  60 x 220 x 85 = 1,122,000
--  cells, two-phase oil/water, central injector, corner producers.
--
--  GENERATED by benchmark/make_spe10.py from the public dataset;
--  do not edit by hand, re-run the generator instead.  The header
--  of make_spe10.py records exactly what is faithful to the spec
--  and what is simplified.
-- =====================================================================

TITLE    SPE10 MODEL 2 60x220x85

NCOMP    2
MODEL    BLACKOIL
OUTDIR   /home/tonishi/Workdir/repos/reservoir_simulation_mixed_precision/full_reservoir_simulator/GPU_reservoir_simulator/cuda/benchmark/spe10/OUTPUT_SPE10
CASENAME SPE10

-- ---- GRID ----------------------------------------------------------
NX       60
NY       220
NZ       85
DX       20
DY       10
DZ       2
PERMFILE  benchmark/runs/SPE10/SPE10_perm.txt
PERMZFILE benchmark/runs/SPE10/SPE10_permz.txt          -- per-cell Kz: SPE10's kv/kh is not a scalar
POROFILE  benchmark/runs/SPE10/SPE10_poro.txt          -- independent measured porosity
POROMIN  1e-4          -- floor under the file's 1e-7 dead-cell stand-in

-- ---- PROPS ---------------------------------------------------------
PVTCONST 1             -- dead oil, constant B; see the generator header
UW       0.3
UO       3.0
BW       1.01
BO       1.01
RS       0
RHOW     1.025181
RHOO     0.848978
CFW      0.0
CFO      0.0
CT       0.0
SWI      0.2           -- with SWR, makes relperm2 the spec's exact curves
SWR      0.2
PINIT    6000
PBUB     6000
PATM     14.6959
SWINIT   0.2           -- connate water: the reference OWC is at the base
SGINIT   0.0
SOINIT   0.8
GRAVITY  1
DARCY    1.127e-3
REFACTOR 0.2

-- Two-phase: the NVRS kernel uses analytic Corey curves
--     krw = S^2,  kro = (1-S)^2,  S = (Sw-SWI)/(1-SWI-SWR)
-- which at SWI = SWR = 0.2 are exactly the SPE10 model 2 relative
-- permeabilities, so no SWOF table is needed or read.

-- ---- SOLVER --------------------------------------------------------
KRYLOV   FGMRES
LINTOL   1e-2
LINMAXIT 200
RESTART  30
AMGFAST  1
AMGREUSE 10
AMGREUSEGROWTH 2.0
MIXED    1
EMULATE  1
JACOBIAN ANALYTIC

-- ---- TIME ----------------------------------------------------------
DTREPORT   100
TEND       2000
DTGROW     2
NEWTONMAX  20
NEWTONSTALLMAX 4       -- abandon a sub-step that stops reducing the
                       --   residual; a stall does not recover, and the
                       --   full Newton budget is the price of every
                       --   lost attempt
DTKEEP     1           -- carry dt ACROSS report steps, as Flow does,
DTCONTROL  1           --   and rescale it from the last converged
                       --   sub-step's Newton count instead of resetting
                       --   onto a dyadic lattice at every report step
OPMCONV    1           -- Flow's getReservoirConvergence: exempt a small
                       --   pore-volume share from the strict CNV bound.
                       --   Leave CNVRELAXPV and CNVRELAXED at their
                       --   defaults (0.03 and 1e9); the 1e9 is the
                       --   mechanism, and tightening it makes the
                       --   relaxed test identical to the strict one and
                       --   OPMCONV worthless.
NEWTONTOL  5e-3
DPMAX      500
DSMAX      0.2
MAXCHOP    8           -- the 10^7 contrast may want 0.39-day steps early

-- ---- OUTPUT --------------------------------------------------------
MAKECSV      1
MAKESUMMARY  1
ECLOUT       1
                       --    reads these to render spe10.html
AUTOPLOT     0

-- ---- WELLS:  I  J  TYPE  RATE  RW  SKIN  PWF  PERF  NAME ------------
-- The reference pattern: INJ at (30,110) rate-controlled with a
-- 10,000 psi BHP cap, producers at the four corners at 4000 psi BHP,
-- all perforated through every layer.  rw = 1.0 ft is the reference
-- deck's 2 ft wellbore diameter.
WELLS
  30 110   1   5000   1.0   0.0  10000   all INJ
   1   1  -1     -1   1.0   0.0   4000   all P1
  60   1  -1     -1   1.0   0.0   4000   all P2
  60 220  -1     -1   1.0   0.0   4000   all P3
   1 220  -1     -1   1.0   0.0   4000   all P4
/
