-- =====================================================================
--  NVRS-CUDA — ONE MILLION CELL BENCHMARK
--
--  200 x 200 x 25 = 1,000,000 active cells, three-phase black oil.
--  This is the scaling case: 3,000,000 unknowns, ~63 million Jacobian
--  nonzeros, solved with mixed-precision CPR (FP32 BoomerAMG under an
--  FP64 FGMRES, df64-emulated FP64 operator).
--
--  Run it across every GPU on the node:
--      ./scripts/run.sh decks/MILLION.DATA
--  NZ = 25, so the K-slab decomposition supports up to 25 ranks.
--
--  Sizing notes
--  ------------
--    field           10,000 x 10,000 x 500 ft
--    pore volume     1e6 cells * 50*50*20 ft3 * 0.175 mean poro
--                    = 8.75e9 ft3 ~ 1.56e9 bbl
--    snapshots       1e6 cells * 4 fields * 4 B = 16 MB each
--
--  No PERMFILE is given, so the deterministic smooth synthetic field is
--  used over [PERMMIN, PERMMAX] — the shipped permeability files only
--  cover the small reference grids (1089, 4800 and 12000 cells).
-- =====================================================================

TITLE   ONE MILLION CELL BENCHMARK

-- ---- MODEL / RUNSPEC ------------------------------------------------
NCOMP   3             -- 3 = oil/water/gas.  Must precede MODEL.
MODEL   BLACKOIL
OUTDIR  OUTPUT_1M
CASENAME MILLION

-- ---- GRID -----------------------------------------------------------
NX      200
NY      200
NZ      25
DX      50            -- ft
DY      50
DZ      20
KZMULT  0.2           -- Kz = KZMULT * Kx
PERMMIN 5             -- mD, synthetic field range
PERMMAX 500
POROMIN 0.05
POROMAX 0.30

-- ---- PROPS (fluid) --------------------------------------------------
UW      1.0
UO      2.5
UG      0.02
BW      1.0
BO      1.2
BG      0.005
RHOW    1.0
RHOO    0.8
RHOG    0.01
CFW     0.00001
CFO     0.00001
CT      0.00002
SWI     0.1
SWR     0.1
PINIT   3000
PBUB    3000
PATM    14.6959
SWINIT  0.2
SGINIT  0.02
SOINIT  0.78
GRAVITY 0             -- matches the CuPy reference, whose pressure
                      -- equation carries no rho*g*z term

-- ---- SWOF: water-oil (Sw, Krow, Krw) --------------------------------
SWOF
 0.00  1.0000 0.0000
 0.30  1.0000 0.0000
 0.35  0.5900 0.0100
 0.40  0.3200 0.0200
 0.45  0.1800 0.0340
 0.50  0.0800 0.0460
 0.55  0.0300 0.0680
 0.60  0.0100 0.0900
 0.65  0.0010 0.1280
 0.70  0.0001 0.1660
 0.75  0.0000 0.2000
 0.80  0.0000 0.2400
 1.00  0.0000 0.2400
/

-- ---- SGOF: gas-oil (Sg, Krog, Krg) ----------------------------------
SGOF
 0.00  1.0000 0.0000
 0.03  0.7500 0.0000
 0.05  0.5900 0.0200
 0.10  0.3200 0.0900
 0.15  0.1800 0.1600
 0.20  0.0800 0.2400
 0.25  0.0300 0.3300
 0.30  0.0100 0.4300
 0.35  0.0010 0.5500
 0.40  0.0000 0.6700
 0.45  0.0000 0.8100
 0.50  0.0000 1.0000
 1.00  0.0000 1.0000
/

-- ---- SOLVER ---------------------------------------------------------
KRYLOV   FGMRES
LINTOL   1e-2
LINMAXIT 100          -- raising this does not help the case that hits it:
                      --    at dt = 100 days the solve reaches only
                      --    rel 0.77 in 100 iterations, and the answer is
                      --    a smaller step, not more iterations.  See DTMAX.
RESTART  30
MIXED    1            -- FP32 BoomerAMG (set at build time; see the banner)
EMULATE  1            -- double-word df64 FP64 operator
JACOBIAN ANALYTIC     -- exact 3-phase derivatives; much cheaper than the
                      -- 7*bs residual evaluations the numerical path needs
-- LINSOLVER: which library supplies the stage-1 pressure multigrid.
-- AMGX (default), HYPRE, or GINKGO (an FP16 multigrid on one GPU;
-- GINKGOPREC 16 or 32).  This chooses the multigrid ONLY.  The
-- mixed-precision arrangement is identical either way: FP64 outer
-- FGMRES over a df64-emulated FP64 operator, an FP32 multigrid inside
-- the CPR preconditioner, and the same bs x bs block-Jacobi second
-- stage.  A binary built without AmgX falls back to HYPRE and says so.
LINSOLVER AMGX
AMGFAST  1             -- coarsen aggressively and keep the coarsest grid on
                       --    the device.  Seven levels at 2.07 ms per V-cycle
                       --    become three at 1.11 ms: the cycle is dominated
                       --    by per-level overhead, not by arithmetic, so
                       --    removing levels is what pays.
AMGREUSE 10            -- Newton iterations that may reuse the AMG hierarchy,
AMGREUSEGROWTH 2.0     --    unless Krylov exceeds this many times the count
                       --    the fresh one needed.  A rebuild costs 94 ms on
                       --    two GPUs against a 1.3 ms V-cycle, so it is worth
                       --    tolerating a lot of extra iterations to avoid
                       --    one.  4 and 1.3 rebuilt far too eagerly.
-- ---- Physical constants ---------------------------------------------
DARCY    1.127e-3
GRAVGRAD 0.4335
REFACTOR 0.2
FDEPS    1e-7

-- ---- TIME / SCHEDULE ------------------------------------------------
DTREPORT   100        -- days per report step
DTMAX      6.25       -- cap on the internal step, and the single largest
                      --    saving in this deck.  Without it the first report
                      --    step is attempted at 100 days, fails, and is
                      --    retried at 50, 25 and 12.5 before 6.25 succeeds.
                      --    Every one of those attempts runs 20 Newtons of
                      --    100 Krylov iterations and is then thrown away:
                      --    10,688 AMG applies to produce an answer that
                      --    needs 1,830.  Starting at 6.25 took the run from
                      --    23.0 s to 5.4 s on one GB200.
-- DTGROW: consecutive first-attempt successes before the step is
-- doubled.  1 is the old behaviour, which lengthened after every
-- success including ones that had just been chopped, so dt overshot,
-- chopped back and overshot again.  On BENCH3P that cost a discarded
-- attempt on 11 of 20 report steps.
DTGROW   2
TEND       1000       -- 10 report steps; raise once the timing is known
NEWTONMAX  20
NEWTONSTALLMAX 4       -- abandon a sub-step that stops reducing the residual
DTKEEP     1           -- carry dt across report steps, as Flow does
DTCONTROL  1           --   and rescale from the last converged Newton count
OPMCONV    1           -- Flow's getReservoirConvergence: the signed component
                       --   material balance and the local CNV bound, tested
                       --   at every Newton iteration.  Leave CNVRELAXPV and
                       --   CNVRELAXED at their defaults, 0.03 and 1.0, which
                       --   are Flow's own.  Setting CNVRELAXED to CNVTOL
                       --   makes the relaxed test identical to the strict
                       --   one and OPMCONV buys nothing.
LINESEARCH 6           -- backtrack the Newton update until the residual
                       --   descends; the accepted trial is reused by the
                       --   next iteration, so alpha = 1 is free.
APPLEYARD  1           -- chop a saturation update that crosses a relperm
                       --   endpoint so it lands just past it.
NEWTONTOL  5e-3
DPMAX      500        -- per-cell Newton step limits
DSMAX      0.2
MAXCHOP    6

-- ---- OUTPUT ---------------------------------------------------------
MAKECSV      1
MAKESUMMARY  1
ECLOUT       1
AUTOPLOT     1

-- ---- WELLS:  I  J  TYPE  RATE  RW  SKIN  PWF  PERF  NAME -------------
--  Eight injectors on a peripheral ring, eight producers on an inner
--  pattern.  Voidage balance, with WI = 2*pi*C*k*dz/ln(re/rw) ~ 11.9 at
--  the mean 252 mD and an oil mobility of ~0.27 over 25 perforated
--  layers:
--      q_o ~ 25 * 11.9 * 0.27 * (p - pwf)  ~  80 * drawdown  STB/D
--  so pwf = 2750 gives ~20,000 STB/D per producer, ~160,000 STB/D from
--  eight of them, matched by 8 x 20,000 STB/D of injection.  Over 1000
--  days that is ~1.6e8 STB against a 1.56e9 bbl pore volume, about 10%
--  of a pore volume — a realistic early waterflood.
WELLS
  34   34   1  20000   0.5   0.0  2750   all I1
 100   34   1  20000   0.5   0.0  2750   all I2
 166   34   1  20000   0.5   0.0  2750   all I3
  34  100   1  20000   0.5   0.0  2750   all I4
 166  100   1  20000   0.5   0.0  2750   all I5
  34  166   1  20000   0.5   0.0  2750   all I6
 100  166   1  20000   0.5   0.0  2750   all I7
 166  166   1  20000   0.5   0.0  2750   all I8
  67   67  -1     -1   0.5   0.0  2750   all P1
 133   67  -1     -1   0.5   0.0  2750   all P2
  67  133  -1     -1   0.5   0.0  2750   all P3
 133  133  -1     -1   0.5   0.0  2750   all P4
 100  100  -1     -1   0.5   0.0  2750   all P5
 100   67  -1     -1   0.5   0.0  2750   all P6
  67  100  -1     -1   0.5   0.0  2750   all P7
 133  100  -1     -1   0.5   0.0  2750   all P8
/
